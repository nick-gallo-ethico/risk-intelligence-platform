# Ethico Risk Intelligence Platform - Frontend Environment Variables
#
# Copy this file to .env.local and update the values for your environment.
# NEVER commit .env.local to version control.

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL (required for production)
# Development default: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL (defaults to NEXT_PUBLIC_API_URL if not set)
# Development default: http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
