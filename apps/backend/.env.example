# ===========================================
# Backend Environment Configuration
# ===========================================
# Copy this file to .env

# Node Environment
NODE_ENV=development

# Server
PORT=3000
HOST=0.0.0.0

# ===========================================
# Database (PostgreSQL) with Connection Pooling
# ===========================================
# Prisma connection pool is configured via URL parameters.
# These parameters prevent connection exhaustion under load.
#
# connection_limit: Max connections per Prisma Client instance
#   - Default: 10 (too low for production)
#   - Recommended: 50 for most deployments
#   - Formula: (available_connections / app_instances)
#   - Azure PG Basic tier: 50 max, Standard: 100-500
#
# pool_timeout: Seconds to wait for available connection
#   - Default: 10
#   - Recommended: 30 for high-load scenarios
#   - If exceeded, throws P2024 error (timed out getting connection)
#
# connect_timeout: Initial connection timeout (seconds)
#   - Default: 5
#   - Increase if DB is geographically distant
#
# Development URL (local PostgreSQL):
DATABASE_URL=postgresql://ethico:ethico_dev@localhost:5432/ethico_dev?schema=public&connection_limit=50&pool_timeout=30&connect_timeout=10

# Production example:
# DATABASE_URL=postgresql://user:pass@prod-host:5432/ethico?schema=public&connection_limit=50&pool_timeout=30&connect_timeout=10

# Note: DB_POOL_SIZE is for documentation/reference only.
# Actual pool size is controlled via connection_limit in DATABASE_URL.
DB_POOL_SIZE=50
DB_CONNECT_TIMEOUT=10000
DB_IDLE_TIMEOUT=60000
DB_STATEMENT_TIMEOUT=30000
PGBOUNCER_MODE=false

# Redis Cache & Job Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# HS256 secret (used as fallback during RS256 migration)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ===========================================
# RS256 Asymmetric Key Configuration (Recommended)
# ===========================================
# RS256 provides better security than HS256:
# - Key rotation without mass user logout
# - Public key can be distributed to microservices for verification
# - Private key never leaves the auth service
#
# DEVELOPMENT: Leave these empty - keys are auto-generated on startup.
# PRODUCTION: Generate and configure RSA keys.
#
# Generate RSA key pair (2048-bit minimum):
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Option 1: Base64-encode for env vars (recommended for Docker/K8s):
#   JWT_RS256_PRIVATE_KEY=$(cat private.pem | base64 -w 0)
#   JWT_RS256_PUBLIC_KEY=$(cat public.pem | base64 -w 0)
#
# Option 2: Use escaped newlines:
#   JWT_RS256_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv..."
#
# Option 3: Store in Azure Key Vault (production):
#   Add secrets jwt-rs256-private-key and jwt-rs256-public-key
#
JWT_RS256_PRIVATE_KEY=
JWT_RS256_PUBLIC_KEY=
JWT_RS256_KEY_ID=

# Key rotation settings
# Old keys remain valid for verification during this overlap period
# Default: 7 days (matches refresh token lifetime)
JWT_RS256_ROTATION_ENABLED=true
JWT_RS256_KEY_OVERLAP_DAYS=7

# Algorithm selection (RS256 or HS256)
# RS256 is default and recommended. HS256 is fallback for migration.
JWT_ALGORITHM=RS256

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Email (Mailhog for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ethico.local

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# AI Configuration (Anthropic Claude API)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_DEFAULT_PROVIDER=claude
AI_DEFAULT_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=4096

# AI Rate Limiting (per organization defaults)
# These are used when an organization has no custom limits configured
AI_DEFAULT_RPM=60
AI_DEFAULT_TPM=100000
AI_DEFAULT_DAILY_REQUESTS=10000
AI_DEFAULT_DAILY_TOKENS=5000000
